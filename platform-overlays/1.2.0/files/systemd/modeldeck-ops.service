[Unit]
Description=ModelDeck local host operations
After=docker.service network-online.target
Wants=docker.service
Before=gateway-admin.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/cix/gateway-admin
ExecStart=/usr/bin/python3 -B -m host_ops.server
Restart=on-failure
RestartSec=5
RuntimeDirectory=modeldeck-ops
RuntimeDirectoryMode=0755
StateDirectory=modeldeck-ops
StateDirectoryMode=0700
UMask=0077

[Install]
WantedBy=multi-user.target
