# Generate with: python hash_password.py
ADMIN_PASSWORD_HASH=pbkdf2_sha256$260000$replace-salt$replace-digest

# Generate a random value of at least 32 bytes. This is shared only between
# the admin service and its internal restricted agent.
ADMIN_AGENT_TOKEN=replace-with-random-token

# Independent token used only by ModelDeck to manage API Keys and usage data
# through the gateway's internal endpoints.
GATEWAY_MANAGEMENT_TOKEN=replace-with-another-random-token
